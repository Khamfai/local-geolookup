{
  "name": "local-geolookup",
  "version": "1.1.2",
  "description": "Fast offline reverse geocoder for Bun & Node.js using SQLite R*Tree index",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "local-geolookup": "./dist/cli.js"
  },
  "files": [
    "dist",
    "data/geonames.sqlite",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node test/parse.test.js && node test/sqlite.test.js && node test/geocoder.test.js",
    "bench": "bun run scripts/benchmark.ts",
    "cli": "bun run src/cli.ts",
    "build:db": "bun run scripts/build_db.ts",
    "update:data": "bun run scripts/update_data.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "reverse-geocoding",
    "reverse-geocoder",
    "geocoder",
    "geolookup",
    "geonames",
    "sqlite",
    "rtree",
    "bun",
    "nodejs",
    "gis",
    "coordinates",
    "offline"
  ],
  "author": "phai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Khamfai/local-geolookup.git"
  },
  "homepage": "https://github.com/Khamfai/local-geolookup#readme",
  "bugs": {
    "url": "https://github.com/Khamfai/local-geolookup/issues"
  },
  "engines": {
    "node": ">=22.5.0",
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "~7.0.2"
  }
}
