{
  "name": "local-geolookup",
  "version": "1.0.1",
  "description": "Fast offline reverse geocoder for Bun & Node.js using SQLite R*Tree index",
  "main": "index.js",
  "module": "index.js",
  "types": "index.ts",
  "type": "module",
  "exports": {
    ".": {
      "bun": "./index.ts",
      "types": "./index.ts",
      "import": "./index.js",
      "default": "./index.js"
    }
  },
  "bin": "./cli.js",
  "files": [
    "index.ts",
    "index.js",
    "fast-geocoder.ts",
    "fast-geocoder.js",
    "cli.ts",
    "cli.js",
    "geonames.sqlite",
    "README.md"
  ],
  "scripts": {
    "test": "node test/geocoder.test.js",
    "build:db": "bun run build_db.ts",
    "bench": "bun run benchmark.ts",
    "cli": "bun run cli.ts",
    "prepublishOnly": "npm pack --dry-run"
  },
  "keywords": [
    "reverse-geocoding",
    "reverse-geocoder",
    "geocoder",
    "geolookup",
    "geonames",
    "sqlite",
    "rtree",
    "bun",
    "nodejs",
    "gis",
    "coordinates",
    "offline"
  ],
  "author": "phai",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0",
    "bun": ">=1.0.0"
  }
}
